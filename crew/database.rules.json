{
  "rules": {
    ".read": false,
    ".write": false,
    "crew": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "jobs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "meta": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "photos": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "names": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "log": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$conn": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid) && (!newData.exists() || newData.child('uid').val() == auth.uid)"
      }
    }
  }
}
